{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagMatch": "v*",
    "tagName": "v${version}",
    "tag": false,
    "push": false,
    "requireCommits": true,
    "requireCleanWorkingDir": true,
    "requireUpstream": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "conventionalcommits",
      "infile": "CHANGELOG.md"
    }
  }
}
