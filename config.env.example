# =============================================================================
# opencode-docker configuration
# =============================================================================
# Environment variables consumed by the generator:
#
#   COMPOSE_SERVICE_NAME=<name>
#     Docker Compose service name to emit in the override file.
#     Defaults to "opencode". Set this if you renamed the service in
#     docker-compose.yml.
#
#   WORKSPACE_ROOT=<path>
#     Container-side root for project mount targets.
#     Defaults to "/workspace".
#
# Supported sections:
#
#   TZ=<timezone>
#     Set the container timezone (e.g. Europe/Berlin, America/New_York).
#     Defaults to America/New_York from the Dockerfile if unset.
#
#   SSH_PRIVATE_KEY=<path>
#     Path to an SSH private key to mount into the container at
#     /home/node/.ssh/<basename-of-key>. The path must point to an
#     existing file. Uses the source filename as the target — for
#     example, ~/.ssh/id_rsa mounts to /home/node/.ssh/id_rsa.
#     Use a dedicated, scoped key — do NOT mount your personal ~/.ssh.
#
#   SSH_PUBLIC_KEY=<path>
#     Path to the corresponding SSH public key. Mounted at
#     /home/node/.ssh/<basename-of-key>. Optional — you can omit this
#     if your workflow does not need the public key inside the container.
#
#   env:<NAME>=<value>
#     Any line starting with env: is injected as a runtime environment
#     variable (the prefix is stripped). For example:
#       env:EDITOR=vim            ->   EDITOR=vim
#       env:NODE_ENV=development  ->   NODE_ENV=development
#
#     The env: prefix distinguishes environment variables from project
#     mount entries (which use the same name=value syntax).
#
#   <project-name>=<host-path>
#     Everything else is treated as a project mount. The left side
#     becomes the folder name under /workspace in the container. The
#     right side must point to an existing host directory. Relative
#     paths are resolved from this file's directory.
#
# =============================================================================
# Examples:

# Timezone
# TZ=Europe/Berlin

# SSH credentials (scoped keys only)
# SSH_PRIVATE_KEY=~/.ssh/opencode/id_ed25519
# SSH_PUBLIC_KEY=~/.ssh/opencode/id_ed25519.pub

# Custom environment variables
# env:EDITOR=vim
# env:NODE_ENV=development

# Project mounts
# my-app=/Users/you/Developer/my-app
# api=../api
# docs=../docs
