{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git commit *": "ask",
      "git diff *": "allow",
      "git log *": "allow",
      "git push *": "ask",
      "git status *": "allow",
      "grep *": "allow",
      "npm install *": "ask",
      "npm run check:spell *": "allow",
      "npm run check:types *": "allow",
      "npm run lint *": "allow",
      "npm run test *": "allow",
      "npm run test:run *": "allow",
      "npm run typecheck *": "allow",
      "npx *": "ask",
      "rm -rf *": "deny"
    },
    "codesearch": "ask",
    "doom_loop": "ask",
    "edit": "ask",
    "external_directory": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": "deny",
    "task": "ask",
    "todoread": "allow",
    "todowrite": "ask",
    "webfetch": "allow",
    "websearch": "ask"
  },
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability. If you find a security issue, delegate to @security-engineer.",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "security-engineer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "prompt": "You are a security engineer. Focus on security. You'll be given tasks to figure out, whether there's a risky code snippet, or a CVE we need to address with versions.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  }
}
